<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!--
	 Add a keychain access group here once you know the Team ID / bundle prefix
	 your Secure Enclave keys need to be shared under, e.g.:

	 <key>keychain-access-groups</key>
	 <array>
	 	<string>$(AppIdentifierPrefix)com.hkdfguardkeyprotectionenclave.shared</string>
	 </array>
	-->
</dict>
</plist>
